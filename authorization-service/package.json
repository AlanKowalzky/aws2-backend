{
  "name": "authorization-service",
  "version": "0.1.0",
  "bin": {
    "authorization-service": "bin/authorization-service.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "build:lambda": "esbuild src/functions/*.ts --bundle --outdir=dist/functions --platform=node --target=node18",
    "deploy": "npm run build:lambda && cdk deploy"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "22.7.9",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.25.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "@types/aws-lambda": "^8.10.147",
    "aws-cdk-lib": "2.180.0",
    "aws-lambda": "^1.0.7",
    "constructs": "^10.0.0",
    "dotenv": "^16.4.5"
  }
}
